# PostgreSQL — use your Aiven Service URI (often includes ?sslmode=require)
# Example: postgresql://user:pass@host:port/db?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DEFAULTDB?sslmode=require"

JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Local uploads (development)
UPLOAD_DIR="./uploads"

# Reminder emails (optional — leave empty to skip sending)
SMTP_URL=""

# SMS — set SMS_PROVIDER to "brevo" (default), "twilio", "semaphore", or "telesign"
SMS_PROVIDER="brevo"
BREVO_API_KEY=""
# Sender label shown on SMS (max 11 letters/digits for alphanumeric senders)
BREVO_SMS_SENDER="iSmile"
TELESIGN_CUSTOMER_ID=""
TELESIGN_API_KEY=""
TELESIGN_MESSAGE_TYPE="ARN"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="DENTAL"

# Clinic info (shown in UI)
CLINIC_NAME="RHU Calinog"
SUPPORT_HOURS="Monday–Friday, 8:00 AM – 5:00 PM. For urgent registration or login issues, call during office hours."

# Public URL of the React app (for CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Optional: protect /api/internal/send-appointment-reminders (for Render Cron Jobs)
CRON_SECRET=""
